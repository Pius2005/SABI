# ---------------------------------------------------------------------------
# SABI — copy to .env and adjust. Every value has a safe local default except
# the provider API keys (mock providers are used when keys are absent).
# ---------------------------------------------------------------------------

APP_NAME=SABI
NODE_ENV=development
PORT=4100
# Origins allowed to call the API, comma-separated. Add the deployed frontend
# when the web build is hosted separately, e.g.
# WEB_ORIGIN=https://sabi.vercel.app,http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Storage for the local JSON database (dev default: apps/api/data/db.json)
DATABASE_FILE=
# The production target is PostgreSQL (see docs/ARCHITECTURE.md). The MVP ships
# a dependency-free JSON store so the whole app runs with `npm install` only.
DATABASE_URL=

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-change-me

# The first administrator, created only on an empty production database.
# Leave empty in development: `npm run seed` creates the demo accounts.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Providers: mock | openai (written answers), mock | termii | sendchamp (SMS).
# SMS_CHANNEL=dnd is the transactional route OTPs need; generic is the
# promotional fallback for accounts without DND activation.
# There is no speech API: learners read answers in their own language.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SABI

WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=

# Decision routing (Nace Drex, https://console.nace.ai). Help requests are
# triaged by Drex when this key is set; with no key the local rule set in
# apps/api/src/triage.ts routes them instead.
NACE_API_KEY=

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=

# Privacy / retention (no audio is ever recorded or stored)
TRANSCRIPT_RETENTION_DAYS=30

# Pilot mode serves needs_review translations with a visible notice.
# Set to false for production: only approved strings are served.
ALLOW_UNREVIEWED_TRANSLATIONS=true

CONF_THRESHOLD=0.6
DEFAULT_LANGUAGE=en

# Web (Vite) — exposed to the browser
VITE_APP_NAME=SABI
# Relative by default (the API serves the web build). Use an absolute URL when
# the static build is hosted elsewhere, e.g. https://sabi-api.example.com/api/v1
# and add the web origin to WEB_ORIGIN above.
VITE_API_BASE=/api/v1
